[Unit]
Description=Station Max Telegram Control Bot
After=network-online.target quasar-bridge.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/station-bot
ExecStart=/opt/quasar-bridge/bin/station-bot -env /opt/station-bot/bot.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

