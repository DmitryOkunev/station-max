# Telegram Bot Configuration for Yandex Station Max & Quasar Bridge
# 1. Создайте бота через @BotFather в Telegram и вставьте токен ниже
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOTFATHER_TOKEN_HERE

# 2. Разрешённые Telegram User ID через запятую (fail-closed: если пусто — доступ закрыт,
#    но бот ответит на /start вашим numeric ID для удобного добавления сюда)
TELEGRAM_ALLOWED_USERS=

# === Подключение к Yandex Station Max и Quasar Bridge ===
STATION_IP=192.168.1.50
STATION_SSH_PORT=2222
STATION_SSH_USER=root
STATION_ADB_PORT=5555
STATION_MEDIA_PORT=4545
STATION_UID=

BRIDGE_CONFIG_PATH=/opt/quasar-bridge/config.json
BRIDGE_BIN_PATH=/opt/quasar-bridge/bin/quasar-bridge
BRIDGE_HEALTH_URL=http://127.0.0.1:8443/healthz
BRIDGE_SERVICE_NAME=quasar-bridge
BRIDGE_SERVER_IP=192.168.1.1
STREAM_SCRIPT_PATH=/usr/local/bin/station-stream
BOT_DRAFT_PATH=/opt/station-bot/user_config_draft.json

